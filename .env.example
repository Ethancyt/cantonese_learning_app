# Optional advanced deployment fallback. Normal setup uses /developer; no .env file is required.
# Local demo is the default. Never expose private keys with NEXT_PUBLIC_.
APP_MODE=demo
# Optional OpenAI-compatible text provider. Omit for deterministic demo fallback.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4.1-mini
# Optional speech recognition. Azure is the default; set compatible for a multipart transcription endpoint.
SPEECH_PROVIDER=azure
SPEECH_REGION=eastasia
SPEECH_API_KEY=
# Endpoint and model are used only in compatible mode.
SPEECH_API_URL=https://api.openai.com/v1/audio/transcriptions
SPEECH_MODEL=whisper-1
# Supabase: run npm run supabase:prepare and apply the appropriate SQL file.
# Then set APP_MODE=supabase and both public values below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
